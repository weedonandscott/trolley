# The sanity test diffs these snapshots byte-for-byte against a listing it
# generates at run time. Keep LF in the working tree so the Windows runner's
# autocrlf checkout doesn't add CR to every expected line.
tests/sanity/listings/*.list text eol=lf

# Icon fixtures the sanity test packages with: an autocrlf checkout would
# corrupt the image bytes on the Windows runner.
tests/sanity/icon.ico binary
tests/sanity/icon.png binary

# Fixture for the xz round-trip unit test, which now runs on the Windows
# runner too: autocrlf would rewrite bytes inside the stream and fail the decode.
cli/tests/fixtures/*.tar.xz binary

# include_str!'d into the CLI and written verbatim into every generated ghostty
# config. An autocrlf checkout would bake CRLF into the binary itself, so the
# line endings a user gets would depend on which OS built their trolley.
cli/src/commands/*.conf text eol=lf

# Every vendored file is hashed against its manifest, so all of them have to
# survive a checkout byte-for-byte: a rewritten byte inside a PE image is a
# corrupt binary, and a text one's CRLF would not survive being re-added on a
# machine that normalizes line endings.
runtime/vendor/** binary

# Not hashed, and worth reading in a diff. Last match wins, and `binary` is a
# macro for three attributes, so undoing it takes all three.
runtime/vendor/README.md text diff merge eol=lf
runtime/vendor/**/vendor.json text diff merge eol=lf
