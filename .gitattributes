# The sanity test diffs these snapshots byte-for-byte against a listing it
# generates at run time. Keep LF in the working tree so the Windows runner's
# autocrlf checkout doesn't add CR to every expected line.
tests/sanity/listings/*.list text eol=lf

# Fixture for the xz round-trip unit test, which now runs on the Windows
# runner too: autocrlf would rewrite bytes inside the stream and fail the decode.
cli/tests/fixtures/*.tar.xz binary

# include_str!'d into the CLI and written verbatim into every generated ghostty
# config. An autocrlf checkout would bake CRLF into the binary itself, so the
# line endings a user gets would depend on which OS built their trolley.
cli/src/commands/*.conf text eol=lf
